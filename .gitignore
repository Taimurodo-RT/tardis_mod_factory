# Factorio mod .gitignore

.resources
.claude
run.bat

# Factorio logs
factorio-*.log
*.log

# Temporary files
*.tmp
*.temp
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build artifacts
*.zip
build/
dist/

# Backup files
*.bak
*.backup

# Blender render output (regenerate with tools/blender/*.py)
art/render/**/loop/
art/render/rooms/check-*.png
art/render/**/check*.png
